{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ycsopen-sms.local/schemas/ui-manifest.schema.json",
  "title": "YCSOpen SMS UI relation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "playwrightSources", "redirects", "pages"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "routePrefixes"],
      "properties": {
        "mode": { "enum": ["observed-production-facts", "synthetic-contract"] },
        "routePrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "playwrightSources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "redirects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/redirect" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "index"],
      "properties": {
        "from": { "type": "string", "pattern": "^/" },
        "to": { "type": "string", "pattern": "^/" },
        "index": { "type": "boolean" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "source"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "rowContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyAttribute", "keyClass", "keyExpression"],
      "properties": {
        "keyAttribute": { "const": "data-row-key" },
        "keyClass": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "keyExpression": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*\\.[A-Za-z_$][A-Za-z0-9_$]*$" }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataTestId", "source", "repeated", "obligationIds", "requirementIds",
        "behaviorIds", "catalogTest", "caseId", "playwrightId", "rowContract"
      ],
      "properties": {
        "dataTestId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$" },
        "source": { "type": "string", "minLength": 1 },
        "repeated": { "type": "boolean" },
        "obligationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^OBL-[A-Z0-9-]+$" }
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:REQ-(?:F|NFR)-[A-Z0-9-]+|PROJECT-[A-Z0-9-]+)$" }
        },
        "behaviorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$" }
        },
        "catalogTest": { "type": "string", "pattern": "^T-[A-Z0-9-]+:[a-z]+$" },
        "caseId": { "type": "string", "pattern": "^CASE-[A-Z0-9-]+$" },
        "playwrightId": { "type": "string", "pattern": "^PW-[A-Z0-9-]+$" },
        "rowContract": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/rowContract" }
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "route", "relationKind", "component", "selectors"],
      "properties": {
        "pageId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "route": { "type": "string", "pattern": "^/" },
        "relationKind": { "enum": ["observed-route-fact", "verified-selector-closure"] },
        "component": { "$ref": "#/$defs/component" },
        "selectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/selector" }
        }
      }
    }
  }
}
