{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ycsopen-sms.local/schemas/row-key-registry.schema.json",
  "title": "YCSOpen SMS reviewed row-key classes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "allowedClasses", "deniedClasses"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "allowedClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/allowedClass" }
    },
    "deniedClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/deniedClass" }
    }
  },
  "$defs": {
    "allowedClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "immutable", "sensitive", "reviewed", "allowedProperties", "example"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "classification": { "const": "synthetic-non-sensitive-immutable-business-key" },
        "immutable": { "const": true },
        "sensitive": { "const": false },
        "reviewed": { "const": true },
        "allowedProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
        },
        "example": { "type": "string", "pattern": "^fixture-[a-z0-9-]+$" }
      }
    },
    "deniedClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {
          "enum": [
            "phone-number", "database-id", "localized-label", "mutable-name",
            "mutable-value", "credential", "message-content"
          ]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
