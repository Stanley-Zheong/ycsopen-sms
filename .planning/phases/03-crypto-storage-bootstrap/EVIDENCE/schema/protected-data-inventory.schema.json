{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ycs-protected-data-inventory/v1",
  "title": "YCSOpen protected-data inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "manifest_schema",
    "envelope_contract",
    "targets",
    "digest_targets",
    "candidates",
    "source_surfaces",
    "obligation_readiness"
  ],
  "properties": {
    "manifest_version": { "const": "ycs-protected-data-inventory/v1" },
    "manifest_schema": { "type": "string", "minLength": 1 },
    "envelope_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "maximum_overhead_bytes",
        "database_plaintext_ceiling_bytes",
        "opaque_object_id_ceiling_bytes"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "const": "YCSE/v1" },
        "maximum_overhead_bytes": { "const": 145 },
        "database_plaintext_ceiling_bytes": { "const": 110 },
        "opaque_object_id_ceiling_bytes": { "const": 64 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 24,
      "items": { "$ref": "#/$defs/target" }
    },
    "digest_targets": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/digestTarget" }
    },
    "candidates": {
      "type": "array",
      "minItems": 15,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "source_surfaces": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/sourceSurface" }
    },
    "obligation_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_surface_ids", "reason"],
      "properties": {
        "status": { "enum": ["READY", "BLOCKED_BY_CURRENT_IMPLEMENTATION"] },
        "blocking_surface_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "tokens"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "table", "column", "kind", "classification", "storage_representation",
        "source_bound_bytes", "maximum_complete_envelope_bytes", "storage_capacity_bytes",
        "capacity_result", "migration_state", "blind_index", "tenant_column",
        "identity_column", "readers", "writers", "reason"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
        "table": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "column": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "kind": { "enum": ["DATABASE_FIELD", "PROTECTED_OBJECT_REFERENCE"] },
        "classification": { "const": "PROTECTED" },
        "storage_representation": { "enum": ["INLINE_ENVELOPE", "OPAQUE_PROTECTED_OBJECT_ID"] },
        "source_bound_bytes": { "type": "integer", "minimum": 1 },
        "maximum_complete_envelope_bytes": { "type": "integer", "minimum": 1 },
        "storage_capacity_bytes": { "type": "integer", "minimum": 1 },
        "capacity_result": { "const": "FITS" },
        "migration_state": { "enum": ["CURRENT_EXECUTABLE", "MIGRATABLE_SCHEMA_ONLY"] },
        "blind_index": { "enum": ["REQUIRED_VERSIONED_HMAC", "EXCLUDED_NO_EQUALITY_CONTRACT", "NOT_APPLICABLE"] },
        "tenant_column": { "type": ["string", "null"] },
        "identity_column": { "type": "string", "minLength": 1 },
        "readers": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "writers": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "digestTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "table", "column", "classification", "migration_state", "reason"],
      "properties": {
        "id": { "type": "string" },
        "table": { "type": "string" },
        "column": { "const": "mobile_hash" },
        "classification": { "const": "LEGACY_SHA256_MIGRATION_TARGET" },
        "migration_state": { "enum": ["CURRENT_EXECUTABLE", "MIGRATABLE_SCHEMA_ONLY"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "table", "column", "classification", "executable", "migratable", "future_owner", "sources", "reason"],
      "properties": {
        "id": { "type": "string" },
        "table": { "type": "string" },
        "column": { "type": "string" },
        "classification": { "enum": ["EXCLUDED_PHASE_5_HASH", "NOT_PROTECTED_WITH_REASON", "DEFERRED_OWNER"] },
        "executable": { "type": "boolean" },
        "migratable": { "type": "boolean" },
        "future_owner": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "sourceSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "disposition", "obligation_blocking", "sources", "reason"],
      "properties": {
        "id": { "type": "string" },
        "role": { "enum": ["READER", "WRITER", "READER_WRITER"] },
        "disposition": { "type": "string", "minLength": 1 },
        "obligation_blocking": { "type": "boolean" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
