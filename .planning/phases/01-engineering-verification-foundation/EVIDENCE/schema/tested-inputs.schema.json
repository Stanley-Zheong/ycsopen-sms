{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ycsopen-sms.invalid/schema/phase01-tested-inputs-v1.json",
  "title": "Phase 1 canonical tested inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "inputs"],
  "properties": {
    "schema_version": { "const": "phase01-tested-inputs-v1" },
    "phase": { "const": "01-engineering-verification-foundation" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "sha256", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
          "mode": { "type": "string", "pattern": "^10[0-7]{4}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "enum": ["implementation", "test", "config", "contract", "validator"] }
        }
      }
    }
  }
}
