{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ycsopen-sms.invalid/schema/phase01-verification-evidence-v1.json",
  "title": "Phase 1 verification evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "phase", "obligation_ids", "case_ids", "check_id", "layer",
    "argv", "cwd", "subject_manifest_path", "subject_manifest_digest", "tested_subject_digest",
    "started_at", "completed_at", "environment", "status", "exit_code", "errors", "diagnostics", "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "phase01-verification-evidence-v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "phase": { "const": "01-engineering-verification-foundation" },
    "obligation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "case_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "check_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "layer": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cwd": { "type": "string", "minLength": 1 },
    "subject_manifest_path": { "type": "string", "minLength": 1 },
    "subject_manifest_digest": { "$ref": "#/$defs/sha256" },
    "tested_subject_digest": { "$ref": "#/$defs/sha256" },
    "started_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "completed_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {}, "ci": {}, "java_version": {}, "locale": {}, "node_version": {},
        "os": {}, "platform": {}, "ruby_engine": {}, "ruby_version": {}, "timezone": {}
      }
    },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "exit_code": { "type": ["integer", "null"] },
    "errors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_:-]*$" } },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type", "size"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "media_type": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
