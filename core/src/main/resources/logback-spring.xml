<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="securityRedact"
                    class="com.ycsopen.sms.core.common.security.logging.SecurityRedactionConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{48} - %nopex%securityRedact(%msg)</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
